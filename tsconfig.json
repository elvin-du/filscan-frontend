{
  "compilerOptions": {
    "target": "es5",
     "strict": false,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@/*":["./*"],
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "contants/rank.ts", "i18n/zh/rank.js", "nginx.js", "packages/main"],
  "exclude": ["node_modules"]
}
